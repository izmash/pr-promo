---
import Layout from "../layouts/Layout.astro";
import { Image } from 'astro:assets';

import icon from '../assets/favicon.ico';
import promo from '../assets/pr-promo.mp4';
---

<Layout>
  <!-- Video Hero Section -->
  <div class="relative w-full h-screen overflow-hidden">
  <!-- Wrapper with aspect ratio -->
  <div class="absolute inset-0 flex items-center justify-center">
    <div class="relative w-full max-w-full aspect-video"> <!-- aspect-video to Tailwind dla 16:9 -->
      <iframe 
        class="absolute top-0 left-0 w-full h-full border-0"
        src="https://www.youtube.com/embed/8vJPJyw35Jo?autoplay=1&fs=0&loop=1&modestbranding=1&mute=1&playlist=8vJPJyw35Jo&playsinline=1&rel=0" 
        allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; fullscreen=false"
        allowfullscreen
      ></iframe>
    </div>
  </div>
  <div class="absolute z-10 w-full h-full top-0 flex justify-center items-center">
    <div id="dropdownContainer" class="relative w-fit h-fit bg-reality-blue rounded-md">
      <button id="dropdownBtn" class="hover:bg-blue-600 cursor-pointer text-reality-white md:text-4xl text-xl  py-4 px-6 rounded-md transition duration-200">Download Project Reality</button>
      <div id="dropdown" class="hidden absolute top-full left-0 w-full flex-col
 bg-reality-blue text-xl rounded-b-md [&>a]:hover:bg-blue-600 [&>a]:rounded-md [&>a]:py-2 [&>a]:px-2 [&>a]:w-full transition-all duration-300 ease-in-out">
        <a href="https://files.realitymod.com/builds/r180ww2/prbf2_1.8.0.0_full.torrent"><span class="material-symbols-outlined inline align-middle pr-1">download</span>Torrent</a>
        <a href="https://www.moddb.com/mods/project-reality/downloads/prbf2-v1800-client-installer"><span class="material-symbols-outlined inline align-middle pr-1">download</span>ModDB</a>
      </div>
    </div>
  </div>
</div>

  <!-- Footer -->
  <footer>
    <div class="bg-reality-blue pt-5">
      <div class="max-w-7xl mx-auto text-xl mb-4 h-fit flex flex-row">
        <!-- Footer Image -->
        <div class="">
          <div class="h-48 rounded-lg">
            <Image src={icon} alt="BMP3" width={192} height={192} />
          </div>
        </div>

        <!-- Social links -->
        <div class="w-fit flex items-end">
          <div class="">
            <h3>Socials:</h3>
            <div class="flex flex-row gap-x-2">
              <a href="https://www.youtube.com/channel/UC9QwMtFdgVVrkVoUjzCvTWw" class="hover:text-blue-600 transition duration-200">Youtube</a>
              <a href="https://www.facebook.com/realitymod" class="hover:text-blue-600 transition duration-200">Facebook</a>
              <a href="https://www.instagram.com/projectrealitymod" class="hover:text-blue-600 transition duration-200">Instagram</a>
              <a href="https://github.com/realitymod" class="hover:text-blue-600 transition duration-200">Github</a>
              <a href="https://www.reddit.com/r/ProjectReality/" class="hover:text-blue-600 transition duration-200">Reddit</a>
            </div>
          </div>
        </div>

        <!-- Big links -->
          <div class="grow">
            <div class="flex justify-center items-center gap-6 md:text-xl h-full">
              <a href="https://discord.gg/tSsaU7F" class="w-fit h-fit bg-reality-gray hover:bg-gray-700 text-reality-white py-2 px-4 rounded border border-reality-white transition duration-200 text-center">Join Official PR Discord</a>
              <a href="https://forum.realitymod.com/" class="w-fit h-fit bg-reality-gray hover:bg-gray-700 text-reality-white py-2 px-4 rounded border border-reality-white transition duration-200 text-center">Visit Project Reality Forums<a></a>
          </div>
      </div>
    </div>

    <!-- Second footer -->
    <div class="bg-reality-gray py-5">
      <div class="max-w-7xl mx-auto px-4 text-center text-reality-white opacity-70">
        <p>&copy; 2025 Project Reality. All rights reserved.</p>
      </div>
    </div>
  </footer>
</Layout>

<script>
  // Find our component DOM on the page.
  const dropdownBtn = document.querySelector("#dropdownBtn");
  const dropdown = document.querySelector("#dropdown");
  const dropdownContainer = document.querySelector("#dropdownContainer");

  // Add event listener to toggle dropdown visibility.
  dropdownBtn?.addEventListener('click', () => {
    if (dropdown?.classList.contains("hidden")) {
      dropdown.classList.replace("hidden", "flex");
      dropdownContainer?.classList.replace("rounded-md", "rounded-t-md");
    } else if (dropdown?.classList.contains("flex")) {
      dropdown.classList.replace("flex", "hidden");
      dropdownContainer?.classList.replace("rounded-t-md", "rounded-md");
    }
  });
</script>
